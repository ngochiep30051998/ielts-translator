# Cấu hình bundle web. Chép thành `.env` rồi sửa — `.env` bị .gitignore chặn.
#
# Khác extension ở một điểm căn bản: web KHÔNG có `.env.dev` / `.env.prod` riêng, vì bản
# production không cần biết địa chỉ backend. Nó chạy cùng origin với backend nên mọi lời gọi
# là đường dẫn tương đối. Cả ba biến dưới đây đều CÓ THỂ để trống.
#
# Vite nạp theo thứ tự: `.env` -> `.env.[mode]` -> `.env.[mode].local`. Muốn tách theo mode
# thì dùng `.env.development` / `.env.production` như chuẩn của Vite.

# ─────────────────────────────────────────────────────────────────────────────
# Chỉ dùng lúc `npm run dev` — KHÔNG đi vào bundle
# ─────────────────────────────────────────────────────────────────────────────

# Cổng của Vite dev server.
# Mặc định 5174 (không phải 5173) để không tranh cổng với các project Vite khác.
# `strictPort` bật: sai cổng thì báo lỗi chứ không lặng lẽ nhảy sang cổng khác — cổng nằm
# trong redirect URI đã đăng ký với Google, nhảy cổng là hỏng đăng nhập.
VITE_DEV_PORT=5555

# Backend mà dev server proxy `/api/*` sang.
#
# Proxy chứ không phải gọi thẳng: nhờ nó mà trong lúc dev, trình duyệt vẫn thấy API nằm
# CÙNG origin với trang, nên cookie phiên hoạt động y như production. Trỏ bundle thẳng sang
# `http://127.0.0.1:8080` sẽ biến mọi request thành cross-site và cookie không bao giờ được
# gửi.
VITE_DEV_BACKEND=http://127.0.0.1:8080

# ─────────────────────────────────────────────────────────────────────────────
# Đi vào bundle
# ─────────────────────────────────────────────────────────────────────────────

# Địa chỉ gốc của API. ĐỂ TRỐNG trong hầu hết mọi trường hợp.
#
# Trống = đường dẫn tương đối `/api/...`, đi tới chính origin đang phục vụ trang. Đó là cấu
# hình DUY NHẤT mà đăng nhập hoạt động: cookie phiên mang `SameSite=Lax`, và trình duyệt chỉ
# gửi kèm nó cho request cùng origin.
#
# Lúc `npm run dev`, để trống là ĐỦ: dev server proxy `/api/*` sang VITE_DEV_BACKEND, nên
# trình duyệt vẫn thấy API cùng origin với trang.
#
# Đặt sang origin khác sẽ hỏng ở HAI tầng, phải sửa cả hai:
#   1. CORS chặn ngay — mọi request mang header X-IELTS-Web nên có preflight, mà backend
#      chỉ mở CORS cho chrome-extension://<id>. Thấy ngay "blocked by CORS policy".
#      Sửa ở app/main.py: thêm origin này kèm allow_credentials=True
#   2. Kể cả khi CORS đã mở, cookie SameSite=Lax vẫn không được gửi sang origin khác —
#      request đi được nhưng không mang danh tính, và trả 401 sạch sẽ. Tầng này khó lần hơn.
#      Sửa ở app/auth/cookies.py: đổi cookie phiên sang SameSite=None; Secure
#
# Cả hai hiện CHƯA có. Hãy để trống.
VITE_API_BASE_URL=
