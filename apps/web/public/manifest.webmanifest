  "description": "Dịch hai chiều Việt-Anh chuẩn IELTS band 6.5+ và học từ mới",
  "lang": "vi",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#4f46e5",
  "icons": [
