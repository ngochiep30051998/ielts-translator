{
  "name": "ielts-translator-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "icons": "node ../../scripts/make-icons.mjs --out apps/extension/public/icons --sizes 16,32,48,128",
    "build": "tsc --noEmit && vite build --mode dev",
    "build:prod": "tsc --noEmit && vite build --mode prod",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ielts/core": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
