# --- Gemini ---
GEMINI_API_KEY=thay-bang-key-cua-ban
GEMINI_MODEL=gemini-2.5-flash

# --- Extension ---
# Lấy sau khi build extension và load vào Chrome (cố định nhờ field `key` trong manifest).
EXTENSION_ID=dien-sau-khi-lam-task-7

# --- Đăng nhập Google (bắt buộc từ V6) ---
# OAuth client kiểu "Web application" trên Google Cloud Console.
# Authorized redirect URI phải là: https://<EXTENSION_ID>.chromiumapp.org/
AUTH_GOOGLE_CLIENT_ID=
# CHỈ sống ở backend. Không bao giờ đặt giá trị này vào extension/.env — mọi thứ trong
# bundle extension đều đọc được bởi bất kỳ ai cài nó.
AUTH_GOOGLE_CLIENT_SECRET=

# Danh sách email được phép đăng nhập, ngăn cách bằng dấu phẩy.
# RỖNG = KHÓA HẾT (cố ý: cấu hình thiếu phải làm hệ thống đóng lại, không mở toang).
AUTH_ALLOWED_EMAILS=ban@gmail.com

# Chủ sở hữu toàn bộ dữ liệu ĐÃ CÓ. Migration V6 gán mọi từ trong sổ hiện tại cho email
# này. KHÔNG có mặc định — chạy migration với email đoán bừa sẽ gán sổ từ cho một tài
# khoản không ai đăng nhập được, và Flyway thì không chạy lại.
AUTH_BOOTSTRAP_EMAIL=ban@gmail.com

# Hạn phiên (ngày), trượt theo mỗi lần dùng.
AUTH_SESSION_DAYS=60
# Trần số lượt gọi Gemini mỗi người mỗi ngày. API key dùng chung, nên không có trần thì
# một người làm 200 câu quiz là cả nhóm hết quota. 0 = tắt (chỉ nên dùng ở máy dev).
AUTH_DAILY_GEMINI_CALLS=300

# --- PostgreSQL ---
# Đổi DB_NAME/DB_USER/DB_PASSWORD SAU KHI volume đã tạo thì không có tác dụng:
# POSTGRES_* chỉ chạy ở lần khởi tạo data directory đầu tiên. Muốn đổi thật thì
# `docker compose down -v` (XOÁ SẠCH sổ từ vựng) rồi up lại.
DB_NAME=ielts
DB_USER=ielts
DB_PASSWORD=ielts

# Cổng publish ra host. Chỉ ảnh hưởng host — trong mạng compose db luôn là 5432.
# Đổi cái này thì phải đổi cả spring.datasource.url trong
# backend/config/application-local.yml (lần chạy backend từ IDE).
DB_PORT=5432
APP_PORT=8080

# --- Múi giờ ---
# Quyết định "hôm nay" của lịch ôn tập (SRS). Container mặc định chạy UTC, nên
# thiếu biến này thì ngày ôn đổi lúc 07:00 sáng giờ VN chứ không phải nửa đêm:
# hạn mức từ mới mỗi ngày reset sai giờ và due_date lệch một ngày.
TZ=Asia/Ho_Chi_Minh

# --- Tuỳ chọn: chỉ cần khi muốn lệch khỏi mặc định ---
# DB_HOST=localhost            # docker compose tự set thành 'db'
# SERVER_PORT=8080             # cổng backend lắng nghe bên trong tiến trình
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_TIMEOUT_SECONDS=15
# Sinh cả lô đề quiz lâu hơn dịch một từ; chấm bài viết nằm giữa hai mức.
# GEMINI_QUIZ_GENERATE_TIMEOUT_SECONDS=30
# GEMINI_QUIZ_GRADE_TIMEOUT_SECONDS=20
# GEMINI_RETRY_BACKOFF_MS=1000
